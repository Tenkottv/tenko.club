{
  "name": "tenko-club-site",
  "private": true,
  "type": "module",
  "description": "The tenko.club website: static HTML and CSS served by GitHub Pages.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "http-server site -p 4173 -c-1 --silent",
    "lint": "html-validate \"site/**/*.html\" && eslint .",
    "test": "playwright test",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "http-server": "14.1.1"
  }
}
